  "selector": {
    "diaper_type": {
      "options": {
        "wet": "Wet",
        "dirty": "Dirty",
        "both": "Wet and dirty"
      }
    },
    "feeding_side": {
      "options": {
        "left": "Left",
        "right": "Right",
        "bottle": "Bottle"
      }
    },
    "units": {
      "options": {
        "metric": "Metric (kg, cm)",
        "imperial": "Imperial (lb, in)"
      }
    }
  },
  "services": {
    "log_diaper": {
      "name": "Log diaper",
      "description": "Logs a diaper change.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "type": {
          "name": "Type",
          "description": "What was in the diaper."
        },
        "time": {
          "name": "Time",
          "description": "When it happened. Defaults to now."
        }
      }
    },
    "log_feeding": {
      "name": "Log feeding",
      "description": "Logs a feeding. Entries within the same feeding window as the previous one are added to that feeding as a side switch.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "side": {
          "name": "Side",
          "description": "Left or right breast, or bottle."
        },
        "amount_ml": {
          "name": "Amount",
          "description": "How much was fed (for bottle feeds)."
        },
        "time": {
          "name": "Time",
          "description": "When it happened. Defaults to now."
        }
      }
    },
    "start_sleep": {
      "name": "Start sleep",
      "description": "Marks the baby as asleep.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "time": {
          "name": "Time",
          "description": "When the baby fell asleep. Defaults to now."
        }
      }
    },
    "end_sleep": {
      "name": "End sleep",
      "description": "Marks the baby as awake and stores the sleep in the sleep calendar.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "time": {
          "name": "Time",
          "description": "When the baby woke up. Defaults to now."
        }
      }
    },
    "add_sleep": {
      "name": "Add sleep",
      "description": "Adds a finished sleep after the fact.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "start": {
          "name": "Start",
          "description": "When the baby fell asleep."
        },
        "end": {
          "name": "End",
          "description": "When the baby woke up."
        }
      }
    },
    "undo": {
      "name": "Undo last action",
      "description": "Reverts the latest logged action, within 30 seconds.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to undo for."
        }
      }
    },
    "delete_event": {
      "name": "Delete entry",
      "description": "Deletes a logged diaper, feeding or sleep.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby the entry belongs to."
        },
        "event_id": {
          "name": "Entry ID",
          "description": "The ID of the logged entry (shown in the dashboard card)."
        }
      }
    },
    "log_growth": {
      "name": "Log growth",
      "description": "Logs a weight and/or length measurement.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "weight": {
          "name": "Weight",
          "description": "Weight in kg (metric) or lb (imperial)."
        },
        "length": {
          "name": "Length",
          "description": "Length or height in cm (metric) or inches (imperial)."
        },
        "units": {
          "name": "Units",
          "description": "Units of the weight and length. Stored as metric."
        },
        "date": {
          "name": "Date",
          "description": "When it was measured. Defaults to today."
        },
        "note": {
          "name": "Note",
          "description": "Optional note."
        }
      }
    },
    "delete_growth": {
      "name": "Delete measurement",
      "description": "Deletes a logged growth measurement.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby the measurement belongs to."
        },
        "event_id": {
          "name": "Measurement ID",
          "description": "The ID of the measurement."
        }
      }
    },
    "set_milestone": {
      "name": "Reach milestone",
      "description": "Marks a milestone as reached, or changes the date it was reached.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "milestone": {
          "name": "Milestone",
          "description": "The milestone key, e.g. first_steps, or the ID of a milestone you added."
        },
        "date": {
          "name": "Date",
          "description": "When it was reached. Defaults to today."
        },
        "note": {
          "name": "Note",
          "description": "Optional note. Leave it out to keep the current note."
        }
      }
    },
    "clear_milestone": {
      "name": "Clear milestone",
      "description": "Marks a milestone as not reached.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "milestone": {
          "name": "Milestone",
          "description": "The milestone key or ID."
        }
      }
    },
    "add_milestone": {
      "name": "Add milestone",
      "description": "Adds a milestone of your own, reached on the given date if one is set.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "name": {
          "name": "Name",
          "description": "What the baby did, e.g. First swim."
        },
        "date": {
          "name": "Date",
          "description": "When it was reached. Leave empty to add it as not reached yet."
        },
        "note": {
          "name": "Note",
          "description": "Optional note."
        }
      }
    },
    "delete_milestone": {
      "name": "Delete milestone",
      "description": "Deletes a milestone you added.",
      "fields": {
        "config_entry_id": {
          "name": "Baby",
          "description": "The baby to log for."
        },
        "milestone": {
          "name": "Milestone",
          "description": "The ID of the milestone you added."
        }
      }
    }
  }
}
